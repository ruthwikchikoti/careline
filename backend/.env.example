# CareLine backend — local config. Copy to `.env` and fill in (never commit .env).
#
# A real LLM is the primary reasoner. Set ONE provider key; the spine prefers
# OpenAI when OPENAI_API_KEY is present, else Anthropic, else the offline twins.

OPENAI_API_KEY=sk-...your-openai-key...

# Optional overrides:
# CARELINE_LLM_MODEL=gpt-5.5        # default for OpenAI; set gpt-4o etc. if needed
# CARELINE_LLM_BACKEND=openai       # force a backend (openai | anthropic | heuristic)
# CARELINE_LLM_EFFORT=high
# ANTHROPIC_API_KEY=sk-ant-...      # alternative provider
# CARELINE_MONGO_URI=mongodb://localhost:27017   # optional; omit for in-memory/offline

# --- Auth (REVIEW-2, SECURITY-2) ---------------------------------------------
# Per-doctor login credentials: each doctor id has its OWN salted hash, so one
# doctor's password never opens another doctor's console. Comma-separated
# "doctor_id:<hash>" entries; generate a hash (prompts for the password) with:
#   python -m careline.adapters.auth.hash_password --doctor-id dr-asha
# When set, only the listed ids can sign in and CARELINE_DOCTOR_PASSWORD is
# ignored. REQUIRED in production / public-demo mode. ($ is literal in this file;
# in docker-compose YAML write each $ as $$.)
# CARELINE_DOCTOR_CREDENTIALS=dr-asha:pbkdf2_sha256$600000$<salt>$<hash>,dr-x:pbkdf2_sha256$...
#
# Shared dev/local-demo FALLBACK — used only when CARELINE_DOCTOR_CREDENTIALS is
# unset: this one password opens ANY doctor id. Unset = the published dev default
# ("careline-dev-doctor-password"). Production / public-demo mode refuse to start
# while it is set at all.
# CARELINE_DOCTOR_PASSWORD=change-me-to-a-long-random-string
# Optional allowlist of doctor ids that may sign in (comma-separated):
# CARELINE_DOCTOR_IDS=dr-asha

# --- Abuse guards (REVIEW-4/5, SECURITY-2) ------------------------------------
# Login lockout: failures per account (doctor id / doctor+patient, from any IP)
# and per client IP (across ALL doctor/patient ids, so spraying one guess per id
# is stopped) before a 429 lockout of CARELINE_LOGIN_LOCKOUT_SECONDS.
# CARELINE_LOGIN_MAX_FAILURES=5
# CARELINE_LOGIN_MAX_FAILURES_PER_IP=20
# CARELINE_LOGIN_LOCKOUT_SECONDS=900
# Budget guard (0 = off): per-IP spend POSTs/minute, a SEPARATE per-IP login
# window (unset = same value as the spend limit; own counter), and a daily cap.
# CARELINE_RATE_LIMIT_PER_MINUTE=0
# CARELINE_LOGIN_RATE_LIMIT_PER_MINUTE=
# CARELINE_DAILY_REQUEST_CAP=0
# Reverse proxies in front of the app that append to X-Forwarded-For. 0 (local)
# ignores XFF; 1 on Render keys per-IP guards on the rightmost hop and also
# trusts X-Forwarded-Proto for the request scheme only (https redirects).
# CARELINE_TRUSTED_PROXY_HOPS=0

# --- Public deploy hardening (REVIEW-6) ---------------------------------------
# A publicly reachable demo: keeps /demo/* mounted but refuses to START unless
# CARELINE_JWT_SECRET, CARELINE_INTERNAL_API_KEY, CARELINE_PIN_HMAC_SECRET (each
# >= 32 bytes, not the dev defaults) and CARELINE_DOCTOR_CREDENTIALS are set, and
# CARELINE_DOCTOR_PASSWORD is NOT set. CARELINE_ENVIRONMENT=production applies the same
# guard and also unmounts the demo routes.
# CARELINE_PUBLIC_DEMO=false
