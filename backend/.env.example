# CareLine backend — local config. Copy to `.env` and fill in (never commit .env).
#
# A real LLM is the primary reasoner. Set ONE provider key; the spine prefers
# OpenAI when OPENAI_API_KEY is present, else Anthropic, else the offline twins.

OPENAI_API_KEY=sk-...your-openai-key...

# Optional overrides:
# CARELINE_LLM_MODEL=gpt-5.5        # default for OpenAI; set gpt-4o etc. if needed
# CARELINE_LLM_BACKEND=openai       # force a backend (openai | anthropic | heuristic)
# CARELINE_LLM_EFFORT=high
# ANTHROPIC_API_KEY=sk-ant-...      # alternative provider
# CARELINE_MONGO_URI=mongodb://localhost:27017   # optional; omit for in-memory/offline

# --- Auth (REVIEW-2) ---------------------------------------------------------
# Doctor console login credential. POST /auth/token mints a doctor JWT only when
# {doctor_id, password} matches. Unset = the published dev default
# ("careline-dev-doctor-password"), which production / public-demo mode refuse
# at startup. Use >= 12 characters.
# CARELINE_DOCTOR_PASSWORD=change-me-to-a-long-random-string
# Optional allowlist of doctor ids that may sign in (comma-separated):
# CARELINE_DOCTOR_IDS=dr-asha
